{
  "name": "parliament",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable orchestration control plane for agent workflows: replayable event histories, leased workers, idempotent tool execution, and human approval gates.",
  "license": "MIT",
  "author": "Nischay Rawal",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build:dashboard && tsx src/api/main.ts",
    "replay": "tsx src/cli/replay.ts",
    "demo": "./scripts/demo.sh",
    "bench": "tsx bench/run.ts",
    "serve:demo": "npm run build:dashboard && tsx src/api/main.ts --demo",
    "build:dashboard": "tsc -p dashboard/tsconfig.json",
    "serve:nobuild": "tsx src/api/main.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
